<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0b0e14">
    <title>Xiangdong Huang · hxd77</title>
    <meta name="description" content="{{ page.description | escape }}">
    <link rel="canonical" href="{{ '/' | absolute_url }}">
    <meta property="og:title" content="Xiangdong Huang · hxd77">
    <meta property="og:description" content="{{ page.description | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ '/' | absolute_url }}">
    <meta property="og:image" content="{{ page.profile.image | prepend: '/assets/img/' | absolute_url }}">
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%230b0e14'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-size='40' font-family='monospace' fill='%23c3f66d'%3Eh%3C/text%3E%3C/svg%3E"
    >
    <link rel="stylesheet" href="{{ '/assets/css/home.css' | relative_url }}">
    <script src="{{ '/assets/js/home.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <header class="home-header">
      <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="hxd77 首页">hxd77<span aria-hidden="true">✳</span></a>
      <nav aria-label="主导航">
        <a href="#research">研究方向</a>
        <a href="#work">代码实践</a>
        <a href="#about">关于我</a>
      </nav>
      <a class="nav-contact" href="mailto:{{ site.data.socials.email }}">联系我 <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> XIANGDONG HUANG / RESEARCH & CODE</p>
          <h1 id="hero-title">
            Curiosity.<br>
            Code.<br>
            <span class="accent-word">Possibility<span class="title-dot">.</span></span>
          </h1>
          <p class="hero-intro">
            在智能、隐私与计算之间，<br>
            探索更多可能。
          </p>
          <p class="hero-detail">
            Hi, I'm <strong>hxd77</strong>. 一名来自青岛的研究生。<br>
            关注大语言模型、差分隐私、零知识证明与 GPU。
          </p>
          <div class="hero-actions">
            <a class="button button-solid" href="#research">探索我的研究方向 <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="hero-art">
          <div class="orbit orbit-one" aria-hidden="true"></div>
          <div class="orbit orbit-two" aria-hidden="true"></div>
          <div class="art-cross cross-one" aria-hidden="true">+</div>
          <div class="art-cross cross-two" aria-hidden="true">+</div>
          <figure class="portrait-frame">
            <img
              src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
              alt="Xiangdong Huang 在城市夜景前的个人照片"
              width="1254"
              height="1254"
              fetchpriority="high"
            >
            <figcaption><span>HUANG, XIANGDONG</span><span>QINGDAO → EVERYWHERE</span></figcaption>
          </figure>
          <div class="art-label label-top"><span class="label-dot" aria-hidden="true"></span> ALWAYS EXPLORING</div>
          <div class="art-label label-bottom"><span aria-hidden="true">⌘</span> ideas → experiments → code</div>
        </div>
        <a class="scroll-cue" href="#research"><span aria-hidden="true">↓</span> SCROLL TO EXPLORE</a>
        <span class="hero-index" aria-hidden="true">PERSONAL LOG / 001</span>
      </section>
      <div class="direction-strip" aria-label="四个研究方向">
        <div class="shell strip-inner">
          <span>LLM</span><i aria-hidden="true">✳</i><span>DIFFERENTIAL PRIVACY</span><i aria-hidden="true">✳</i><span>ZERO-KNOWLEDGE</span
          ><i aria-hidden="true">✳</i><span>GPU COMPUTING</span>
        </div>
      </div>
      <section id="research" class="section shell" aria-labelledby="research-title">
        <div class="section-top">
          <p class="eyebrow">01 / RESEARCH INTERESTS</p>
          <span class="section-aside">四个方向，一份好奇心。</span>
        </div>
        <h2 id="research-title">
          问题的交叉点，<br>
          <span class="muted">也是灵感的起点。</span>
        </h2>
        <div class="research-grid">
          {% for item in page.research %}
            <article class="research-card">
              <div class="card-top">
                <span class="card-code">{{ item.code }}</span><span class="card-number">0{{ forloop.index }}</span>
              </div>
              <div class="research-visual visual-{{ item.visual }}" aria-hidden="true">
                {% case item.visual %}
                  {% when 'neural' %}
                    <svg viewBox="0 0 280 120">
                      <g class="network-lines"><path d="M55 28L140 18L225 38M55 28L140 60L225 38M55 60L140 18M55 60L140 60L225 82M55 92L140 60M55 92L140 102L225 82M140 18L225 82M140 102L225 38"/></g><g class="network-nodes"><circle cx="55" cy="28" r="6"/><circle cx="55" cy="60" r="6"/><circle cx="55" cy="92" r="6"/><circle cx="140" cy="18" r="6"/><circle cx="140" cy="60" r="9"/><circle cx="140" cy="102" r="6"/><circle cx="225" cy="38" r="6"/><circle cx="225" cy="82" r="6"/></g>
                    </svg>
                  {% when 'privacy' %}
                    <svg viewBox="0 0 280 120">
                      <path class="privacy-wave wave-noise" d="M15 91L30 72L45 83L60 59L75 71L90 33L105 48L120 14L135 41L150 22L165 54L180 43L195 78L210 69L225 90L240 80L265 95"/><path class="privacy-wave" d="M15 94C70 94 87 24 140 24S205 94 265 94"/><path class="chart-axis" d="M15 103H265"/><text x="234" y="28">ε</text>
                    </svg>
                  {% when 'proof' %}
                    <svg viewBox="0 0 280 120">
                      <path class="proof-shape" d="M140 9L186 32V69L140 110L94 69V32Z"/><path class="proof-check" d="M119 59L135 75L162 44"/><path class="proof-orbit" d="M68 60H94M186 60H212"/><circle cx="62" cy="60" r="5"/><circle cx="218" cy="60" r="5"/>
                    </svg>
                  {% when 'compute' %}
                    <div class="compute-grid">
                      {% for cell in (1..32) -%}
                        <span></span>
                      {%- endfor %}
                    </div>
                {% endcase %}
              </div>
              <h3>{{ item.name }}</h3>
              <p class="card-english">{{ item.english }}</p>
              <p class="card-description">{{ item.description }}</p>
              <p class="card-keywords">{{ item.keywords }}</p>
            </article>
          {% endfor %}
        </div>
      </section>
      <section id="work" class="section shell work-section" aria-labelledby="work-title">
        <div class="section-top">
          <p class="eyebrow">02 / CODE & EXPLORATION</p>
          <a class="text-link" href="https://github.com/{{ site.data.socials.github_username }}?tab=repositories"
            >全部仓库 <span aria-hidden="true">↗</span></a
          >
        </div>
        <h2 id="work-title">把好奇心，<span class="muted">写进代码。</span></h2>
        <div class="work-grid">
          {% for project in page.projects %}
            <a class="work-card" href="{{ project.url }}">
              <div class="work-card-top">
                <span>{{ project.category }}</span><span class="work-arrow" aria-hidden="true">↗</span>
              </div>
              <span class="work-number" aria-hidden="true">{{ project.number }}</span>
              <h3>{{ project.name }}</h3>
              <p>{{ project.description }}</p>
              <span class="repo-label">VIEW REPOSITORY <span aria-hidden="true">→</span></span>
            </a>
          {% endfor %}
        </div>
      </section>
      <section id="about" class="section shell about-section" aria-labelledby="about-title">
        <div>
          <p class="eyebrow">03 / A LITTLE ABOUT ME</p>
          <h2 id="about-title">
            保持好奇。<br>
            <span class="muted">持续构建。</span>
          </h2>
          <div class="about-signature" aria-hidden="true">hxd77<span>_</span></div>
        </div>
        <div class="about-copy">
          {{ content }}
          <div class="tool-tags"><span>Python</span><span>C++</span><span>CUDA</span><span>Keep learning ↗</span></div>
        </div>
      </section>
      <section class="contact-section shell" aria-labelledby="contact-title">
        <p class="eyebrow">LET'S CONNECT</p>
        <h2 id="contact-title">
          下一个想法，<br>
          从一次交流开始<span>.</span>
        </h2>
        <a class="button button-solid" href="mailto:{{ site.data.socials.email }}">聊聊研究与代码 <span aria-hidden="true">↗</span></a>
      </section>
    </main>
    <footer class="home-footer shell">
      <span>© {{ 'now' | date: '%Y' }} Xiangdong Huang</span><span>Built with curiosity & code.</span>
      <div class="footer-links">
        <a href="{{ '/blog/' | relative_url }}">文章</a><a href="{{ '/projects/' | relative_url }}">项目归档</a><a href="#main">回到顶部 ↑</a>
      </div>
    </footer>
  </body>
</html>
